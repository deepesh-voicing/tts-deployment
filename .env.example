OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible endpoint:
# LLM_BASE_URL=http://localhost:8000/v1

TTS_URL=https://abhran--tts-l40s-qwen3-tts-serve.modal.run/v1/audio/speech
TTS_TRANSPORT=http
TTS_SOURCE_SAMPLE_RATE=8000
OUTPUT_SAMPLE_RATE=8000
# TTS_BEARER_TOKEN=
# Qwen CustomVoice settings:
TTS_VOICE=Vivian
TTS_LANGUAGE=English
TTS_API_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
# Only used by voice-cloning checkpoints:
TTS_REF_AUDIO=
TTS_REF_TEXT=
TTS_TIMEOUT_SECONDS=180
TURN_TIMEOUT_SECONDS=240

# Fill these from the providers you actually deploy. Cost fields stay null if omitted.
LLM_INPUT_USD_PER_1M=
LLM_OUTPUT_USD_PER_1M=
MODAL_USD_PER_SECOND=
# Average active GPU containers during the load-test phase. Leave blank if unknown.
MODAL_AVERAGE_CONTAINERS=
